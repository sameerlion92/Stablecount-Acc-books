# =============================================================================
# Self-hosted personal server (recommended)
# =============================================================================
# All data stays on your machine under STABLECOUNT_DATA_DIR:
#   - SQLite database (stablecount.db)
#   - Uploaded documents and template images (uploads/)
#
# Copy this file to .env and adjust values.

NODE_ENV=production

# Persistent data directory (database + all uploaded files)
STABLECOUNT_DATA_DIR=/var/lib/stablecount

# Public URL users open in the browser (required behind reverse proxy)
APP_URL=https://books.yourdomain.com

# Session cookies: secure flag is derived from APP_URL (https => secure).
# For plain HTTP self-hosting, use http://... and leave COOKIE_SECURE unset/false.
# COOKIE_SECURE=false

# Email for password reset — use SMTP on your personal server:
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=accounts@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
MAIL_FROM="Stablecount Acc-books <accounts@yourdomain.com>"

# Or use Resend instead of SMTP (leave SMTP_HOST empty):
# RESEND_API_KEY=re_xxxxxxxx

# Personal server mode — all data and files stay on STABLECOUNT_DATA_DIR.
# Do NOT set cloud vars below on your personal server.

# Optional explicit lock (also enforced automatically when STABLECOUNT_DATA_DIR is set):
# STABLECOUNT_FORCE_LOCAL=1

# =============================================================================
# Vercel / cloud hosting (optional — leave unset on personal server)
# =============================================================================
# DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
