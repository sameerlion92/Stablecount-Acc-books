# Turso/libSQL database used for users, accounting records, and audit history.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Vercel's Turso integration may provide the same values as
# Stable_TURSO_DATABASE_URL and Stable_TURSO_AUTH_TOKEN automatically.

# Private Vercel Blob store used for contracts and order documents.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
